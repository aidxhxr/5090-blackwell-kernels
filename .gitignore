# private research / planning notes (kept out of the public repo)
context/

# build artifacts
build/
*.o
*.so
*.a
*.ncu-rep
*.nsys-rep
*.egg-info/
dist/
.eggs/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# benchmark outputs are regenerated on the GPU; keep the folder, not the data
results/*.json
results/*.png
results/*.csv
results/ncu_*.txt
results/headline.md
!results/.gitkeep
# the roofline is the one output the README links to, so it is committed after a run, and
# env.txt (the GPU state it was measured in) goes with it
!results/roofline.png
!results/env.txt
# the parity run on real weights (docs/design/llm_parity.md) is small and quoted in the docs
!results/llm_parity.json
# scripts/llm_parity.py's dumps of logits and hidden states (gigabytes)
parity_work/
# the real-checkpoint serving comparison (docs/design/llm_serving.md) needs vLLM's venv and
# a downloaded checkpoint to regenerate, so its rows are kept
!results/llm_serve.json

# editors / OS
.vscode/
.idea/
.DS_Store

# any extra build directory (build_exp/, build-121/ ...)
build*/
